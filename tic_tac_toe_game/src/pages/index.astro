---
const PRIMARY_COLOR = "#2196F3";
const SECONDARY_COLOR = "#FFFFFF";
const ACCENT_COLOR = "#FF9800";
const EMPTY_BOARD = Array(9).fill(null);

// PUBLIC_INTERFACE
function checkWinner(board) {
  const lines = [
    [0,1,2], [3,4,5], [6,7,8], // rows
    [0,3,6], [1,4,7], [2,5,8], // cols
    [0,4,8], [2,4,6]           // diagonals
  ];
  for (let [a, b, c] of lines) {
    if (
      board[a] &&
      board[a] === board[b] &&
      board[a] === board[c]
    ) {
      return board[a]; // "X" or "O"
    }
  }
  return null;
}

// PUBLIC_INTERFACE
function isDraw(board) {
  return board.every(cell => cell) && !checkWinner(board);
}
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>TicTacToe Classic</title>
    <meta name="viewport" content="width=device-width" />
    <style>
      :root {
        --primary: #2196F3;
        --secondary: #FFFFFF;
        --accent: #FF9800;
        --bg: #F8F9FB;
      }
      html, body {
        background: var(--bg);
        color: #222;
        min-height: 100vh;
        margin: 0;
        padding: 0;
        font-family: 'Inter', Arial, sans-serif;
      }
      body {
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
      }
      .container {
        background: var(--secondary);
        border-radius: 18px;
        box-shadow: 0 6px 24px 0 #0001;
        padding: 2.5rem 2rem 2rem 2rem;
        min-width: 320px;
        max-width: 95vw;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 1.7rem;
      }
      .turn-info {
        font-size: 1.1rem;
        font-weight: 500;
        margin-bottom: 0.2rem;
      }
      .status-message {
        color: var(--accent);
        font-size: 1rem;
        min-height: 1.3em;
        margin-bottom: 0.7rem;
        letter-spacing: 0.5px;
      }
      .board {
        display: grid;
        grid-template-columns: repeat(3, 54px);
        grid-template-rows: repeat(3, 54px);
        gap: 0.45rem;
        justify-content: center;
        align-items: center;
        background: transparent;
        border-radius: 10px;
        box-shadow: 0 2px 10px #0001;
        margin-bottom: 0.8rem;
      }
      .cell {
        width: 54px;
        height: 54px;
        background: var(--secondary);
        border: 2.2px solid var(--primary);
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 2rem;
        font-weight: 700;
        color: var(--primary);
        transition: background .15s;
        cursor: pointer;
        user-select: none;
      }
      .cell.winner {
        background: var(--primary);
        color: var(--secondary);
        border-color: var(--accent);
        animation: winner-glow 1.1s infinite alternate;
      }
      @keyframes winner-glow {
        from { box-shadow: 0 0 10px 0 var(--accent); }
        to   { box-shadow: 0 0 24px 3px var(--accent); }
      }
      .cell.disabled {
        pointer-events: none;
        cursor: default;
        background: #f2f2f2;
        color: #c1c1c1;
      }
      .controls {
        display: flex;
        flex-direction: column;
        align-items: center;
        width: 100%;
        gap: 0.8rem;
      }
      .restart-btn {
        padding: 0.45em 1.6em;
        background: var(--primary);
        color: var(--secondary);
        border: none;
        border-radius: 8px;
        font-size: 1.07rem;
        font-weight: 600;
        letter-spacing: 0.6px;
        cursor: pointer;
        transition: background 0.17s;
        box-shadow: 0 1px 4px #0001;
      }
      .restart-btn:hover, .restart-btn:focus {
        background: var(--accent);
        color: var(--secondary);
        outline: none;
      }
      @media (max-width: 430px) {
        .container { padding: 1rem 0.5rem; }
        .board, .cell { width:100%;}
        .cell { font-size: 1.45rem; height: 38px; width: 38px;}
        .board { grid-template-columns: repeat(3, 38px); grid-template-rows: repeat(3, 38px);}
      }
    </style>
  </head>
  <body>
    <div class="container" id="tictactoe-container">
      <div id="turn-info" class="turn-info">
        Player <span id="current-player">X</span>'s turn
      </div>
      <div id="status-message" class="status-message"></div>
      <div class="board" id="tictactoe-board">
        <!-- JS will populate cells -->
      </div>
      <div class="controls">
        <button class="restart-btn" id="restart-btn" type="button">Restart Game</button>
      </div>
    </div>
    <script type="module">
      // TicTacToe logic & state (local, two-player)
      const BOARD_SIZE = 9;
      let board = Array(BOARD_SIZE).fill(null);
      let currentPlayer = "X";
      let winner = null;
      let gameOver = false;
      let winLine = null;

      const primary = getComputedStyle(document.documentElement).getPropertyValue('--primary');
      const secondary = getComputedStyle(document.documentElement).getPropertyValue('--secondary');
      const accent = getComputedStyle(document.documentElement).getPropertyValue('--accent');

      const $ = selector => document.querySelector(selector);
      const $$ = selector => document.querySelectorAll(selector);

      const boardDiv = $("#tictactoe-board");
      const turnInfo = $("#current-player");
      const statusMsg = $("#status-message");
      const restartBtn = $("#restart-btn");

      // PUBLIC_INTERFACE
      function checkWinner(board) {
        const lines = [
          [0,1,2],[3,4,5],[6,7,8], // rows
          [0,3,6],[1,4,7],[2,5,8], // cols
          [0,4,8],[2,4,6] // diags
        ];
        for (let i = 0; i < lines.length; i++) {
          const [a, b, c] = lines[i];
          if (board[a] && board[a] === board[b] && board[a] === board[c]) {
            return {winner: board[a], winLine: [a, b, c]};
          }
        }
        return null;
      }

      // PUBLIC_INTERFACE
      function isDraw(board) {
        // All cells filled, no winner
        return board.every(cell => cell) && !checkWinner(board);
      }

      function renderBoard() {
        boardDiv.innerHTML = "";
        for (let i = 0; i < 9; i++) {
          const cellDiv = document.createElement("div");
          cellDiv.className = "cell";
          cellDiv.dataset.idx = i;
          cellDiv.textContent = board[i] || "";
          if (winner && winLine && winLine.includes(i)) {
            cellDiv.classList.add("winner");
          }
          if (board[i] || gameOver) {
            cellDiv.classList.add("disabled");
          }
          cellDiv.addEventListener("click", onCellClick, {once: true});
          boardDiv.appendChild(cellDiv);
        }
      }

      function renderStatus() {
        if (winner) {
          statusMsg.textContent = `Player ${winner} wins! 🎉`;
        } else if (isDraw(board)) {
          statusMsg.textContent = "It's a draw!";
        } else {
          statusMsg.textContent = "";
        }
      }

      function updateTurnInfo() {
        turnInfo.textContent = currentPlayer;
      }

      function onCellClick(e) {
        if (gameOver) return;
        const idx = parseInt(e.target.dataset.idx, 10);
        if (board[idx]) return; // another guard
        board[idx] = currentPlayer;
        // Check winner
        const winObj = checkWinner(board);
        if (winObj) {
          winner = winObj.winner;
          winLine = winObj.winLine;
          gameOver = true;
        } else if (isDraw(board)) {
          winner = null;
          gameOver = true;
        } else {
          currentPlayer = currentPlayer === "X" ? "O" : "X";
        }
        updateTurnInfo();
        renderBoard();
        renderStatus();
      }

      function restartGame() {
        board = Array(9).fill(null);
        currentPlayer = "X";
        winner = null;
        winLine = null;
        gameOver = false;
        updateTurnInfo();
        renderBoard();
        renderStatus();
      }

      restartBtn.addEventListener("click", restartGame);

      // Initial render
      restartGame();

    </script>
  </body>
</html>
